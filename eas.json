{
  "cli": {
    "version": ">= 22.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production-apk": {
      "distribution": "internal",
      "environment": "production",
      "node": "22.23.1",
      "env": {
        "EAS_BUILD_DISABLE_NPM_CACHE": "1",
        "EAS_NO_FROZEN_LOCKFILE": "1"
      },
      "android": {
        "buildType": "apk",
        "image": "sdk-57"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "node": "22.23.1",
      "env": {
        "EAS_BUILD_DISABLE_NPM_CACHE": "1",
        "EAS_NO_FROZEN_LOCKFILE": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}